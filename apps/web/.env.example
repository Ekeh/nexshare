# Local dev: optional. Copy to apps/web/.env.local if you want to override
# where the dev server proxies /api/* and /uploads/* to (see next.config.js).
# Defaults to http://localhost:8000 — only needed if your API runs elsewhere.
API_URL=http://localhost:8000

# Production (Docker/Coolify): API_URL must instead be passed as a BUILD
# ARG, not a runtime env var — see apps/web/Dockerfile and
# ../../DEPLOYMENT.md. Next.js evaluates next.config.js's rewrites() (which
# reads this var) once at `next build`, so setting it only at container
# start has no effect.
