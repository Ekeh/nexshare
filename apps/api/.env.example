# Copy to apps/api/.env and adjust as needed. All values below are the
# defaults baked into app/core/config.py, so a local dev setup works even
# without a .env file at all — this file exists for when you need to
# override something (e.g. a real JWT secret outside of dev).

DATABASE_URL=postgresql+psycopg://nexshare:nexshare@localhost:5432/nexshare
REDIS_URL=redis://localhost:6379/0
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]
PUBLIC_BASE_URL=http://localhost:3000

# Must be >= 32 bytes for HS256 (RFC 7518 §3.2). Never use the default
# outside of local development.
JWT_SECRET=dev-only-secret-change-me-please-32bytes-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_COOKIE_NAME=access_token
ACCESS_TOKEN_EXPIRE_SECONDS=1209600

# Email/phone verification (see app/services/notifications). Leave either
# key unset and that channel's code is just logged to the API console
# instead of actually sent — registration still works, nothing crashes.
RESEND_API_KEY=
RESEND_FROM_EMAIL=NexShare <onboarding@resend.dev>
TERMII_API_KEY=
TERMII_SENDER_ID=N-Alert
VERIFICATION_CODE_TTL_MINUTES=10
VERIFICATION_MAX_ATTEMPTS=5
VERIFICATION_RESEND_COOLDOWN_SECONDS=60
PENDING_VERIFICATION_TOKEN_TTL_MINUTES=30

# Paystack (see app/services/paystack.py) — the real payment rail for
# promoter payouts. Leave unset and withdrawing behaves as before this was
# wired up (a Payout row is created and just stays "requested" forever).
# Use a test secret key (sk_test_...) to exercise the whole flow against
# Paystack's sandbox without moving real money.
PAYSTACK_SECRET_KEY=
